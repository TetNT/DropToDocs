{
  "manifest_version": 3,
  "name": "DropToDocs",
  "version": "1.2.0",
  "homepage_url": "https://appinbound.com/DropToDocs/",
  "description": "Drop Word, Excel or PowerPoint files and open them in Google Docs, Sheets or Slides.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DropToDocs",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["identity", "storage"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ]
}
